# --- LLM (OpenCode, OpenAI-compatible) ---
# Free Zen (default): https://opencode.ai/zen/v1/ + a free model (e.g. deepseek-v4-flash-free)
# Go (subscription):  https://opencode.ai/zen/go/v1/ + a Go model (e.g. kimi-k3)
OPENAI_API_KEY=your-opencode-api-key
OPENAI_BASE_URL=https://opencode.ai/zen/v1/
LLM_MODEL=deepseek-v4-flash-free

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_COLLECTION=velov_faq

# --- Logfire (metrics + tracing) ---
LOGFIRE_TOKEN=your-logfire-token

# --- Rerank model ---
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Cyclocity FAQ ingestion (dlt) ---
# Public client key, shipped in the velov.grandlyon.com SPA bundle (not a secret).
SOURCES__VELOV_FAQ__CLIENT_KEY=c3d9f5c22a9157a7cc7fe0e38269573bdd2f13ec48f867360ecdcbd35b196f87
