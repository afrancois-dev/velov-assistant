{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "title": "Total Queries over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), COUNT(*) AS queries FROM requests GROUP BY 1 ORDER BY 1",
          "format": "table"
        }
      ]
    },
    {
      "title": "Latency breakdown (retrieval vs LLM)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), AVG(latency_retrieval_ms) AS retrieval, AVG(latency_llm_ms) AS llm FROM requests GROUP BY 1 ORDER BY 1",
          "format": "table"
        }
      ]
    },
    {
      "title": "User feedback distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT CASE WHEN rating > 0 THEN 'Thumbs up' ELSE 'Thumbs down' END AS feedback, COUNT(*) AS count FROM feedback GROUP BY 1",
          "format": "table"
        }
      ]
    },
    {
      "title": "Vector search vs function calling",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT intent, COUNT(*) AS count FROM requests WHERE intent IN ('rag','tool','rag+tool') GROUP BY 1",
          "format": "table"
        }
      ]
    },
    {
      "title": "Error rate & token consumption",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT $__timeGroupAlias(ts, '1m'), SUM(total_tokens) AS tokens, COUNT(*) FILTER (WHERE error IS NOT NULL) AS errors FROM requests GROUP BY 1 ORDER BY 1",
          "format": "table"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["velov"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Velo'v Assistant Monitoring",
  "uid": "velov-monitoring",
  "version": 1
}
